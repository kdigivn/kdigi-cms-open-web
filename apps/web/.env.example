# Public site URL (canonical, sitemap, Open Graph). Baked at build time.
NEXT_PUBLIC_SITE_URL=https://cms.kdigi.vn
NEXT_PUBLIC_DOCS_URL=https://docs.cms.kdigi.vn
NEXT_PUBLIC_APP_URL=https://app.cms.kdigi.vn

# KDIGI CMS that holds the FAQs and posts of this site (server-side reads only).
CMS_URL=https://app.cms.kdigi.vn
# siteKey of this site in the CMS `sites` collection.
CMS_SITE_KEY=opencms

# Shared secret the CMS sends in the `x-revalidate-secret` header to POST /api/cms/revalidate.
# Without it the route answers 503 (never open).
REVALIDATE_SECRET=
