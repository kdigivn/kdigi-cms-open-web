---
/**
 * Header kính (glass): logo · tab khu vực · ô tìm kiếm · nhóm phải (chọn ngôn ngữ, giao diện sáng/tối).
 *
 * Dùng flex thay cho grid 3 cột của Starlight. Các component con lấy qua
 * `virtual:starlight/components/*` để vẫn tôn trọng override của người dùng.
 * Trên mobile, chọn ngôn ngữ và giao diện nằm ở chân menu trượt (MobileMenuFooter mặc định của Starlight).
 */
import config from 'virtual:starlight/user-config';
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import SocialIcons from 'virtual:starlight/components/SocialIcons';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';

import SectionNav from './SectionNav.astro';

/** Giữ nguyên điều kiện của Starlight: chỉ render Search khi Pagefind bật hoặc Search đã bị override. */
const shouldRenderSearch =
  config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';
---

<div class="hd-header">
  <div class="title-wrapper sl-flex">
    <SiteTitle />
  </div>
  <SectionNav variant="header" />
  <div class="hd-header__search sl-flex print:hidden">
    {shouldRenderSearch && <Search />}
  </div>
  <div class="sl-hidden md:sl-flex print:hidden right-group">
    <div class="sl-flex social-icons">
      <SocialIcons />
    </div>
    <LanguageSelect />
    <ThemeSelect />
  </div>
</div>
