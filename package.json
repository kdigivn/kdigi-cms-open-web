{
  "name": "kdigi-cms-open-web",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "description": "Marketing homepage (apps/web) and documentation (apps/docs) for KDIGI CMS: https://opencms.kdigi.vn and https://docs.opencms.kdigi.vn",
  "packageManager": "pnpm@10.32.0",
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:docs": "pnpm --filter docs dev",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter web build",
    "build:docs": "pnpm --filter docs build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "docs:check": "pnpm --filter docs docs:check",
    "sync:docs": "pnpm --filter docs sync:docs"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
